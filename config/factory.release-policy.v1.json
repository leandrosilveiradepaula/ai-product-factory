{
  "policy_key": "factory-release-v1",
  "version": 1,
  "production": {
    "human_release_required": true,
    "auto_merge_allowed": false,
    "human_console_merge_allowed": true,
    "operator_merge_method": "squash",
    "operator_allowed_repositories": [
      "leandrosilveiradepaula/ai-product-factory"
    ]
  },
  "gates": {
    "unknown_paid_cost": "block",
    "missing_nonhuman_definition_of_done": "block",
    "destructive_data_change": "human_gate",
    "expands_sensitive_access": "human_gate",
    "material_requirement_change": "human_gate",
    "production_change": "human_gate",
    "new_paid_service": "human_gate"
  },
  "rollback": {
    "migration_change_requires_verified_rollback": true
  }
}
